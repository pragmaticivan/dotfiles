{{- /* The Pixoo keys arrive with `chezmoi init`. Keep apply usable before that. */ -}}
{{- $pixooEnabled := false -}}
{{- $pixooAddress := "" -}}
{{- if hasKey . "pixooEnabled" }}{{ $pixooEnabled = .pixooEnabled }}{{ end -}}
{{- if hasKey . "pixooAddress" }}{{ $pixooAddress = .pixooAddress }}{{ end -}}
{
  "env": {
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/hooks/statusline.sh"
  },
  "outputStyle": "Concise",
  "skillOverrides": {
    "compound-engineering:ce-compound-refresh": "on",
    "compound-engineering:ce-plan": "on",
    "compound-engineering:ce-polish": "on",
    "compound-engineering:ce-resolve-pr-feedback": "on",
    "compound-engineering:ce-setup": "on",
    "compound-engineering:ce-test-xcode": "on",
    "compound-engineering:ce-work": "on",
    "compound-engineering:lfg": "on"
  },
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "rtk hook claude",
            "type": "command"
          },
          {
            "command": "bash '{{ .chezmoi.homeDir }}/.claude/hooks/git-push-guard.sh'",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bash '{{ .chezmoi.homeDir }}/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "MessageDisplay": [
      {
        "hooks": [
          {
            "command": "/usr/bin/python3 '{{ .chezmoi.homeDir }}/.claude/hooks/message-styler.py'",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ]{{ if $pixooEnabled }},
    "Notification": [
      {
        "hooks": [
          {
            "command": "/usr/bin/python3 '{{ .chezmoi.homeDir }}/.claude/hooks/pixoo-notify.py' notification --host {{ $pixooAddress }}",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "/usr/bin/python3 '{{ .chezmoi.homeDir }}/.claude/hooks/pixoo-notify.py' stop --host {{ $pixooAddress }}",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "/usr/bin/python3 '{{ .chezmoi.homeDir }}/.claude/hooks/pixoo-notify.py' prompt --host {{ $pixooAddress }}",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "command": "/usr/bin/python3 '{{ .chezmoi.homeDir }}/.claude/hooks/pixoo-notify.py' end --host {{ $pixooAddress }}",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ]{{ end }}
  },
  "cleanupPeriodDays": 14,
  "skipWorkflowUsageWarning": true,
  "enabledPlugins": {
{{- range $index, $plugin := .agent_plugins }}
    {{ if $index }},{{ end }}"{{ $plugin.name }}@{{ $plugin.marketplace }}": true
{{- end }}
  },
