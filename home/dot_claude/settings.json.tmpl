{
  "env": {
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/hooks/statusline.sh"
  },
  "skillOverrides": {
    "compound-engineering:ce-compound-refresh": "on",
    "compound-engineering:ce-plan": "on",
    "compound-engineering:ce-polish": "on",
    "compound-engineering:ce-resolve-pr-feedback": "on",
    "compound-engineering:ce-setup": "on",
    "compound-engineering:ce-test-xcode": "on",
    "compound-engineering:ce-work": "on",
    "compound-engineering:lfg": "on"
  },
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "rtk hook claude",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/ste-mode.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/session-start.sh"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "bash '{{ .chezmoi.homeDir }}/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ]
  },
  "cleanupPeriodDays": 14,
  "enabledPlugins": {
    "compound-engineering@compound-engineering-plugin": true,
    "skill-creator@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "compound-engineering-plugin": {
      "source": {
        "repo": "EveryInc/compound-engineering-plugin",
        "source": "github"
      }
    }
  },
  "permissions": {
    "disableBypassPermissionsMode": "disable",
    "defaultMode": "auto",
