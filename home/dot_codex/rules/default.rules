# Codex command policy mirroring ~/.claude/settings.json.
#
# Commands not listed here still run inside the selected permission profile.
# These rules only decide whether a command may escape that sandbox.

# Privilege escalation and catastrophic system administration are forbidden.
forbidden_commands = [
    ["sudo"],
    ["su"],
    ["doas"],
    ["pkexec"],
    ["runas"],
    ["mkfs"],
    ["diskutil", "eraseDisk"],
    ["visudo"],
    ["passwd"],
]

for command in forbidden_commands:
    prefix_rule(
        pattern = command,
        decision = "forbidden",
        justification = "This command is blocked by the global Codex safety policy.",
    )

# Direct network, remote-access, cloud, and infrastructure clients require
# approval before they can leave the network-disabled command sandbox.
prompt_network_commands = [
    ["curl"],
    ["wget"],
    ["nc"],
    ["ncat"],
    ["netcat"],
    ["ssh"],
    ["scp"],
    ["sftp"],
    ["rsync"],
    ["ngrok"],
    ["cloudflared"],
    ["aws"],
    ["gcloud"],
    ["az"],
    ["gsutil"],
    ["terraform"],
    ["pulumi"],
    ["kubectl"],
    ["helm"],
]

for command in prompt_network_commands:
    prefix_rule(
        pattern = command,
        decision = "prompt",
        justification = "This command can access remote systems and requires explicit approval.",
    )

# Package and system installation requires approval.
prompt_install_commands = [
    ["npm", "install", "-g"],
    ["npm", "i", "-g"],
    ["pip", "install"],
    ["pip3", "install"],
    ["brew", "install"],
    ["apt-get", "install"],
    ["apt", "install"],
    ["yum", "install"],
    ["dnf", "install"],
]

for command in prompt_install_commands:
    prefix_rule(
        pattern = command,
        decision = "prompt",
        justification = "Installing packages can execute third-party code and requires explicit approval.",
    )

# Preserve hard stops for commands that target the filesystem root or home.
forbidden_destructive_commands = [
    ["rm", "-rf", "/"],
    ["rm", "-fr", "/"],
    ["rm", "-rf", "/*"],
    ["rm", "-fr", "/*"],
    ["rm", "-rf", "~"],
    ["rm", "-fr", "~"],
    ["rm", "-rf", "~*"],
    ["rm", "-fr", "~*"],
]

for command in forbidden_destructive_commands:
    prefix_rule(
        pattern = command,
        decision = "forbidden",
        justification = "This destructive command form is never allowed by the global policy.",
    )

# Sensitive or externally mutating operations always require confirmation.
prompt_commands = [
    ["git", "push"],
    ["git", "rebase"],
    ["git", "reset", "--hard"],
    ["git", "clean", "-fd"],
    ["git", "tag"],
    ["git", "stash", "drop"],
    ["rm"],
    ["chmod"],
    ["chown"],
    ["dd"],
    ["shred"],
    ["launchctl"],
    ["systemctl"],
    ["service"],
    ["crontab"],
    ["at"],
    ["make", "deploy"],
    ["make", "release"],
    ["npm", "run", "deploy"],
    ["npm", "run", "release"],
    ["npx"],
    ["docker", "rm"],
    ["docker", "rmi"],
    ["docker", "system", "prune"],
    ["docker-compose", "down"],
    ["psql"],
    ["mysql"],
    ["mongosh"],
    ["redis-cli"],
    ["sqlite3"],
]

for command in prompt_commands:
    prefix_rule(
        pattern = command,
        decision = "prompt",
        justification = "This operation can mutate external or difficult-to-recover state.",
    )

# Git fetch is the one networked command explicitly allowed by the Claude policy.
prefix_rule(
    pattern = ["git", "fetch"],
    decision = "allow",
    justification = "Fetching remote refs is read-only and explicitly allowed by the global policy.",
)

# Terraform subcommands that read local files or local state. The broad terraform
# rule above keeps every other subcommand behind a prompt.
allow_terraform_commands = [
    ["terraform", "fmt"],
    ["terraform", "init"],
    ["terraform", "providers"],
    ["terraform", "show"],
    ["terraform", "test"],
    ["terraform", "validate"],
    ["terraform", "version"],
]

for command in allow_terraform_commands:
    prefix_rule(
        pattern = command,
        decision = "allow",
        justification = "This Terraform subcommand is approved by the global policy.",
    )

# Preserve the previously approved project-scoped Context7 documentation helper.
prefix_rule(
    pattern = ["python3", "scripts/context7.py"],
    decision = "allow",
    justification = "The repository-scoped Context7 helper is explicitly approved.",
)
