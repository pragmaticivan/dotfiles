#!/usr/bin/env bash

set -Eeuo pipefail

jar="${HOME}/.local/share/tlaplus/tla2tools.jar"
if [[ ! -f "${jar}" ]]; then
    echo "TLA+ tools are not installed at ${jar}. Run: chezmoi apply ${jar}" >&2
    exit 127
fi

java=$(mise which java)
if [[ ! -x "${java}" ]]; then
    echo "Mise did not return the Java executable" >&2
    exit 127
fi

exec "${java}" -XX:+UseParallelGC -cp "${jar}" tlc2.TLC "$@"
