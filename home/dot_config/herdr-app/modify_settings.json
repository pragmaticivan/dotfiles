{{- /* chezmoi:modify-template */ -}}
{{- /* Herdr writes zoom and other choices to this file. Set only the theme. */ -}}
{{- $settings := dict -}}
{{- if .chezmoi.stdin -}}{{- $settings = fromJson .chezmoi.stdin -}}{{- end -}}
{{- $settings = setValueAtPath "theme" (dict "light" "catppuccin-latte" "dark" "catppuccin") $settings -}}
{{ toPrettyJson $settings }}
