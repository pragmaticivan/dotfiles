#!/usr/bin/env bash
# Brewfile hash: {{ includeTemplate "Brewfile.tmpl" . | sha256sum }}
set -eu

# Xcode
install_xcode_command_line_tools() {
    echo "Xcode command line tools check it..."
    if xcode-select -p >/dev/null 2>&1; then
        echo "Xcode command line tools already installed."
    else
        xcode-select --install || echo "Xcode command line tools install failed."
        echo "Xcode command line tools install done."
    fi
    CURRENT_PATH=$(xcode-select -p)
    DESIRED_PATH="/Library/Developer/CommandLineTools"

    if [ "$CURRENT_PATH" != "$DESIRED_PATH" ]; then
        echo "change path to $DESIRED_PATH"
        sudo xcode-select --switch "$DESIRED_PATH" || {
            echo "path change failed. reset initial settings."
            sudo xcode-select --reset
        }
        echo "$DESIRED_PATH setup done."
    fi
}

install_rosetta() {
    if [[ "$(uname -m)" == "arm64" ]]; then
        echo "Apple Silicon Mac detected. check Rosetta 2 install..."
        /usr/bin/pgrep oahd >/dev/null || /usr/sbin/softwareupdate --install-rosetta --agree-to-license || echo "Rosetta 2 install failed."
    else
        echo "Rosetta 2 not needed (Intel Mac)."
    fi
    echo "Rosetta 2 install done."
}

install_homebrew() {
    echo "Homebrew install check it..."
    if command -v brew >/dev/null 2>&1; then
        echo "Homebrew already installed."
    else
        # Every later step needs brew, so let a failure here stop the script.
        /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
        eval "$(/opt/homebrew/bin/brew shellenv)"
        echo "Homebrew installed."
    fi
}

# Set to 1 when brew bundle fails, and read at the end of the script.
BREW_BUNDLE_FAILED=0

install_brew_packages() {
    # Disable quarantine for casks
    export HOMEBREW_CASK_OPTS=--no-quarantine

    brew --version

    if [ ! -f "${HOME}/Brewfile" ]; then
        echo "Brewfile not found, skipping brew bundle."
        return 0
    fi

    # brew bundle fetches each package before it installs any of them, so one
    # bad checksum in one tap stops all of them. Record that and continue, or
    # a third-party tap can stop mise and each later step too. The script then
    # exits non-zero at the end, so chezmoi reports the failure and tries again.
    if ! brew bundle --file="${HOME}/Brewfile"; then
        BREW_BUNDLE_FAILED=1
        echo "brew bundle failed. These entries are absent:" >&2
        brew bundle check --file="${HOME}/Brewfile" --verbose >&2 || true
    fi

    # These steps only tidy up or report, so a failure must not stop the script.
    brew update || echo "brew update failed."
    brew upgrade || echo "brew upgrade failed."
    brew autoremove || echo "brew autoremove failed."
    brew cleanup || echo "brew cleanup failed."
    brew doctor || echo "brew doctor failed."
    brew list || echo "brew list failed."
    echo "packages install done."
}

install_mise() {
    if command -v mise >/dev/null; then
        echo "mise already installed."
    else
        brew install mise
        mise --version || echo "mise install failed."
    fi

    if [ -f "${HOME}/.config/mise/config.toml" ]; then
        mise i -y || echo "mise install failed."
    fi

    echo "mise setup completed."
}

echo "bootstrap.sh"
echo "--------------------------------"
install_xcode_command_line_tools
install_rosetta
install_homebrew
install_brew_packages
install_mise
echo "--------------------------------"
echo "zsh --version $(zsh --version)"
echo "--------------------------------"

if [ "${BREW_BUNDLE_FAILED}" -ne 0 ]; then
    echo "Package install FAILED. Read the brew bundle output above." >&2
    echo "Each later step ran. chezmoi runs this script again on the next apply." >&2
    exit 1
fi

echo "Package install && update done!!"
echo "--------------------------------"
