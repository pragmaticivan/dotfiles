#!/usr/bin/env bash

set -eufo pipefail

DISTRO=$(lsb_release -i | awk '{print $NF}')

case "$DISTRO" in
"Ubuntu") ;;
*)
  exit 0
  ;;
esac

##########################################

echo 'INSTALLING SOFTWARE PROPERTIES COMMON...'

sudo apt-get install software-properties-common

##########################################

{{ if .pkgs.ubuntu.repositories }}
echo 'ADDING REPOSITORIES...'
{{ range $repository := .pkgs.ubuntu.repositories }}
sudo add-apt-repository '{{ $repository }}'
{{ end }}
{{ end }}

##########################################

echo 'UPDATING SOURCES...'

sudo apt update

##########################################

echo 'INSTALLING PACKAGES...'
sudo apt install {{ .pkgs.ubuntu.pkgs | quoteList | join " " }}

##########################################

echo 'INSTALLING YQ...'

# Ubuntu's apt package "yq" is the unrelated Python/jq-wrapper (kislyuk/yq),
# not the Go binary (mikefarah/yq) our TOML tooling needs. Install the real
# one directly so `yq eval-all --input-format toml ...` works.
if ! yq --version 2>/dev/null | grep -q mikefarah; then
  case "$(uname -m)" in
  x86_64) YQ_ARCH=amd64 ;;
  aarch64 | arm64) YQ_ARCH=arm64 ;;
  *)
    echo "unsupported architecture for yq: $(uname -m)" >&2
    exit 1
    ;;
  esac
  sudo curl -sSfL -o /usr/local/bin/yq "https://github.com/mikefarah/yq/releases/latest/download/yq_linux_${YQ_ARCH}"
  sudo chmod +x /usr/local/bin/yq
fi

##########################################

{{ if .pkgs.ubuntu.repositories }}
echo 'INSTALLING PACKAGES VIA ONE SCRIPT INSTALL...'
{{ range $script := .pkgs.ubuntu.oneScriptInstall }}
curl -sSfL '{{ $script }}' | sh
{{ end }}
{{ end }}
